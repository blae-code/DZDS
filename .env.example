# Copy to .env and fill in. .env is gitignored; never commit it.

# --- GSP SFTP ---
SFTP_HOST=gsp.example.com
SFTP_PORT=8822
SFTP_USER=changeme
SFTP_PASSWORD=changeme
# Remote directory containing profiles/ and mpmissions/ (GSP-specific; often "/" or "/dayz")
SFTP_REMOTE_ROOT=/
REMOTE_PROFILES_DIR=profiles
REMOTE_MPMISSIONS_DIR=mpmissions
# Mission folder name, e.g. dayzOffline.chernarusplus
MISSION_NAME=dayzOffline.chernarusplus

# --- BattlEye RCON ---
RCON_HOST=1.2.3.4
RCON_PORT=2310
RCON_PASSWORD=changeme

# --- Local paths ---
# Steam workshop content dir for DayZ (app 221100) on CachyOS
DAYZ_WORKSHOP_DIR=$HOME/.local/share/Steam/steamapps/workshop/content/221100

# --- Ollama / GM ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
GM_DRY_RUN=1
GM_MAP=chernarusplus
