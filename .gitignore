# Secrets
.env
*.pem
id_*

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Backups / snapshots
backups/*
!backups/.gitkeep
*.bak

# Server runtime noise (keep configs, drop logs & persistence)
server/profiles/*.ADM
server/profiles/*.RPT
server/profiles/*.log
server/profiles/**/*.log
server/profiles/BattlEye/*.log
server/mpmissions/*/storage_*/
server/profiles/BattlEye/beserver_x64*.cfg

# GM daemon state
gm_state/

# Generated output
build/

# Mod signing keys (the private key must never be committed)
*.biprivatekey

# @DZDS command queue (transient; consumed by the server)
server/profiles/DZDS/queue/

# Playwright MCP snapshots (may contain panel data)
.playwright-mcp/

# Static vanilla terrain data in the mission (never edited here; ~100 MB)
server/mpmissions/*/areaflags.map
server/mpmissions/*/mapgroup*.xml
# Server runtime cache + its own profile
server/profiles/DataCache/
server/profiles/users/

# Mod-written secrets and runtime logs (first modded boot, 2026-10-07)
server/profiles/VPPAdminTools/Permissions/credentials.txt
server/profiles/VPPAdminTools/ConfigurablePlugins/SteamAPI.json
server/profiles/VPPAdminTools/Logging/
server/profiles/*/logs/
server/profiles/*/Logs/

# Per-player runtime persistence (2026-10-12): ATM balances and quest progress, keyed by player
server/profiles/ExpansionMod/ATM/
server/profiles/ExpansionMod/Quests/PlayerData/
# Airdrop-Upgraded writes a timestamped backup of its settings on every boot
server/profiles/Airdrop/AirdropSettings_bakup_*.json
# Per-player arrival records (player IDs), 2026-10-15
server/profiles/DZDS/arrivals_ledger.json
# Runtime leftovers from the first 1.30 boots (2026-10-16). sync.sh push skips everything
# ignored here, so a local test boot's state never reaches the live server.
server/profiles/*.mdmp
server/profiles/cf_findfile_*
server/profiles/Zenarchist/*.json.v*
server/mpmissions/*/BunkerBroadcastPersistenceStorage.bin
